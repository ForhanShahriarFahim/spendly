{
  "plansDirectory": ".claude/plans",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python app.py)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip list *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] || exit 0; d=$(cygpath -u \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || printf %s \"$CLAUDE_PROJECT_DIR\"); printf 'export VIRTUAL_ENV=\"%s/venv\"\\nexport PATH=\"%s/venv/Scripts:%s/venv/bin:$PATH\"\\n' \"$d\" \"$d\" \"$d\" >> \"$CLAUDE_ENV_FILE\"",
            "statusMessage": "Activating project venv"
          }
        ]
      }
    ]
  }
}
